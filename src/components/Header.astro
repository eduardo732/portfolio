---
import HeaderLink from "./HeaderLink.astro";
import {
  languages,
  defaultLang,
  getLangFromUrl,
  useTranslations,
  getLocalizedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
// Normalizar base: siempre empieza con / y termina con /
let base = import.meta.env.BASE_URL || '/';
if (!base.startsWith('/')) base = '/' + base;
if (!base.endsWith('/')) base = base + '/';

const homePath = `${base}${lang === defaultLang ? '' : `${lang}/`}`;

const LINKS = [
  { name: t("nav.home"), ref: `${homePath}#top` },
  { name: t("nav.experience"), ref: `${homePath}#experiencia` },
  { name: t("nav.projects"), ref: `${homePath}#proyectos` },
  { name: t("nav.articles"), ref: `${homePath}#articulos` },
  { name: t("nav.aboutMe"), ref: `${homePath}#sobre-mi` },
];
---

<header class="items-center py-5 mx-auto sticky top-0 z-20 border-b border-blueprint-line/60 bg-blueprint-bg/80 backdrop-blur-sm">
  <nav>
    <div
      class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4"
    >
      <div class="flex items-center space-x-3 rtl:space-x-reverse">
        <img
          class="rounded-full object-cover size-14 ring-1 ring-blueprint-accent/50"
          src={`${base}me.webp`}
          alt="edudev photo"
        />
      </div>

      <div class="hidden w-full md:block md:w-auto" id="navbar">
        <ul
          class="font-medium flex flex-col p-4 md:p-0 mt-4 border border-blueprint-line rounded-lg md:flex-row md:space-x-8 rtl:space-x-reverse md:mt-0 md:border-0 bg-blueprint-panel md:bg-transparent"
        >
          {
            LINKS.map((link) => (
              <li class="md:w-auto">
                <HeaderLink {...link} />
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex items-center gap-4">
        <!-- Language Selector -->
        <div class="flex gap-2 bg-blueprint-panel border border-blueprint-line rounded-lg p-1">
          {
            Object.entries(languages).map(([langKey, label]) => (
              <a
                href={getLocalizedPath(currentPath, langKey as keyof typeof languages, base)}
                class={`px-2 py-1 text-sm rounded transition-colors font-mono ${
                  lang === langKey
                    ? "bg-blueprint-accent/20 text-blueprint-accent border border-blueprint-accent/50"
                    : "text-slate-400 hover:bg-blueprint-line/50"
                }`}
              >
                {langKey.toUpperCase()}
              </a>
            ))
          }
        </div>

        <button
          id="navbar-button"
          data-collapse-toggle="navbar-default"
          type="button"
          class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-slate-100 rounded-lg md:hidden focus:outline-none focus:ring-2 focus:ring-blueprint-accent/50 hover:bg-blueprint-line/50"
          aria-controls="navbar-default"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg
            class="w-5 h-5"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 17 14"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M1 1h15M1 7h15M1 13h15"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const navbarButton = document.getElementById("navbar-button");
    const navbar = document.getElementById("navbar");
    navbarButton.addEventListener("click", () => {
      navbar.classList.toggle("hidden");
    });
  });
</script>
