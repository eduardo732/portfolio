---
interface Props {
  ref: string;
  name: string;
}
const { ref, name } = Astro.props;
---

<a
  href={ref}
  class="w-full flex flex-col items-center py-2 px-3 text-slate-100 rounded hover:bg-blueprint-line/50 md:hover:bg-transparent md:border-0 md:hover:text-blueprint-accent md:p-0"
>
  {name}
</a>
