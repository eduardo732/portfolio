---
import { getCollection } from 'astro:content';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

let base = import.meta.env.BASE_URL || '/';
if (!base.startsWith('/')) base = '/' + base;
if (!base.endsWith('/')) base = base + '/';

const langPrefix = lang === 'en' ? 'en/' : '';

const articles = (
  await getCollection(lang === 'en' ? 'articulosEn' : 'articulos')
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<div class="grid gap-6 md:grid-cols-1 lg:grid-cols-2">
  {
    articles.map((article) => (
      <a
        href={`${base}${langPrefix}articulos/${article.slug}`}
        class="group block rounded-lg border border-blueprint-line bg-blueprint-panel/60 p-4 transition-colors hover:border-blueprint-accent"
      >
        <div class="space-y-3">
          <h3 class="text-base font-medium text-slate-100 transition-colors group-hover:text-blueprint-accent">
            {article.data.title}
          </h3>

          <p class="text-xs text-gray-300">{article.data.description}</p>

          <div class="flex flex-wrap gap-1.5">
            {article.data.tags.map((tag: string) => (
              <span class="rounded-full bg-blueprint-accent/10 px-1.5 py-0.5 text-[10px] text-blueprint-accent">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      </a>
    ))
  }
</div>
