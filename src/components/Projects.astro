---
import Github from "../icons/Github.astro";
import Bubble from "./Bubble.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const PROJECT = t('projects.featured');
---
<div class="flex flex-col gap-y-8">
  <div class="rounded-lg border border-blueprint-line bg-blueprint-panel/60 p-6">
    <span class="font-mono text-xs uppercase tracking-widest text-blueprint-accent">
      // {t('projects.featuredLabel')}
    </span>
    <h3 class="mt-2 text-xl font-semibold text-slate-100">
      {PROJECT.title}
    </h3>

    <p class="mt-3 text-justify text-sm text-slate-300">
      {PROJECT.description}
    </p>

    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        PROJECT.metrics.map((metric: { value: string; label: string }) => (
          <div class="rounded-lg border border-blueprint-line bg-blueprint-bg/60 p-3 text-center">
            <p class="font-mono text-2xl font-bold text-blueprint-accent">
              {metric.value}
            </p>
            <p class="mt-1 text-[11px] text-slate-400">{metric.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 flex flex-wrap gap-1.5">
      {
        PROJECT.stack.map((tech: string) => (
          <span class="rounded-full bg-blueprint-accent/10 px-1.5 py-0.5 text-[10px] text-blueprint-accent">
            #{tech}
          </span>
        ))
      }
    </div>

    <p class="mt-4 font-mono text-[11px] uppercase tracking-widest text-slate-400">
      {PROJECT.status}
    </p>
  </div>
  <div class="flex justify-center">
    <Bubble ref="https://github.com/eduardo732">
      <Github class="size-6" />
      {t('projects.githubLink')}
    </Bubble>
  </div>
</div>
