---
import GmailIcon from "../icons/Gmail.astro";
import LinkedinIcon from "../icons/Linkedin.astro";
import InstagramIcon from "../icons/Instagram.astro";
import { getLangFromUrl, useTranslations, defaultLang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

// Normalizar base: siempre empieza con / y termina con /
let base = import.meta.env.BASE_URL || '/';
if (!base.startsWith('/')) base = '/' + base;
if (!base.endsWith('/')) base = base + '/';

const homePath = `${base}${lang === defaultLang ? '' : `${lang}/`}`;

const LINKS = [
  { name: t("nav.home"), ref: `${homePath}#top` },
  { name: t("nav.experience"), ref: `${homePath}#experiencia` },
  { name: t("nav.projects"), ref: `${homePath}#proyectos` },
  { name: t("nav.articles"), ref: `${homePath}#articulos` },
  { name: t("nav.aboutMe"), ref: `${homePath}#sobre-mi` },
];
---

<footer class="border-t border-blueprint-line bg-blueprint-panel/60">
  <div
    class="max-w-screen-xl mx-auto flex flex-col gap-4 px-4 py-6 md:flex-row md:items-center md:justify-between"
  >
    <div class="flex flex-col gap-1">
      <span class="font-mono text-xs uppercase tracking-widest text-blueprint-accent">// EOF</span>
      <span class="text-sm text-slate-400">© {year} @eduuu.dev</span>
    </div>

    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-300">
      {
        LINKS.map((link) => (
          <li>
            <a href={link.ref} class="hover:text-blueprint-accent transition-colors">
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="mailto:eduardo.fuentes.reyes@gmail.com"
        aria-label="Gmail"
        class="opacity-80 hover:opacity-100 transition-opacity"
      >
        <GmailIcon class="size-5" />
      </a>
      <a
        href="https://www.linkedin.com/in/eduardofuentesreyes/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="opacity-80 hover:opacity-100 transition-opacity"
      >
        <LinkedinIcon class="size-5" />
      </a>
      <a
        href="https://www.instagram.com/eduuu.dev/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="opacity-80 hover:opacity-100 transition-opacity"
      >
        <InstagramIcon class="size-5" />
      </a>
    </div>
  </div>
</footer>
