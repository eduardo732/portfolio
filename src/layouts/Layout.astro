---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource-variable/fira-code";
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
// Normalizar base: siempre empieza con / y termina con /
let base = import.meta.env.BASE_URL || '/';
if (!base.startsWith('/')) base = '/' + base;
if (!base.endsWith('/')) base = base + '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="relative left-0 top-0 h-full w-full text-slate-100">
      <div class="blueprint-grid fixed inset-0 -z-10 h-full w-full"></div>
      <Header />
      <slot />
      <Footer />
    </div>

    <script src="../js/main"></script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
  html {
    font-family: "Fira Code Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #0a0f1e;
  }
  .blueprint-grid {
    background-color: #0a0f1e;
    background-image:
      repeating-linear-gradient(
        to right,
        rgba(34, 211, 238, 0.12) 0,
        rgba(34, 211, 238, 0.12) 1px,
        transparent 1px,
        transparent 160px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(34, 211, 238, 0.12) 0,
        rgba(34, 211, 238, 0.12) 1px,
        transparent 1px,
        transparent 160px
      ),
      repeating-linear-gradient(
        to right,
        rgba(34, 211, 238, 0.06) 0,
        rgba(34, 211, 238, 0.06) 1px,
        transparent 1px,
        transparent 32px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(34, 211, 238, 0.06) 0,
        rgba(34, 211, 238, 0.06) 1px,
        transparent 1px,
        transparent 32px
      );
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
